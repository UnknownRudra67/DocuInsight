rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isDocMember(docData) {
      return isSignedIn() && (docData.ownerId == request.auth.uid || (docData.collaborators is list && request.auth.uid in docData.collaborators));
    }

    function isValidDocument(data) {
      return data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.format in ['pdf', 'docx', 'txt'] &&
             data.content is string && data.content.size() <= 500000 &&
             (!('pageCount' in data) || data.pageCount is int) &&
             (!('wordCount' in data) || data.wordCount is int) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 50000)) &&
             (!('summaryStatus' in data) || data.summaryStatus in ['pending', 'processing', 'completed', 'error']) &&
             (!('cloudSource' in data) || data.cloudSource in ['local', 'google_drive', 'dropbox']) &&
             (!('collaborators' in data) || (data.collaborators is list && data.collaborators.size() <= 50));
    }

    function isValidInsight(data) {
      return data.documentId is string && data.documentId.size() > 0 && data.documentId.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
             (!('collaborators' in data) || (data.collaborators is list && data.collaborators.size() <= 50)) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 5000 &&
             data.sourceReference is string && data.sourceReference.size() > 0 && data.sourceReference.size() <= 300 &&
             data.category in ['key_takeaway', 'risk', 'action_item', 'financial', 'statistic'];
    }

    function isValidComment(data) {
      return data.documentId is string && data.documentId.size() > 0 && data.documentId.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
             (!('collaborators' in data) || (data.collaborators is list && data.collaborators.size() <= 50)) &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
             (!('quoteReference' in data) || (data.quoteReference is string && data.quoteReference.size() <= 500)) &&
             (!('resolved' in data) || data.resolved is bool);
    }

    function isValidChatMessage(data) {
      return data.documentId is string && data.documentId.size() > 0 && data.documentId.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
             (!('collaborators' in data) || (data.collaborators is list && data.collaborators.size() <= 50)) &&
             data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
             data.senderRole in ['user', 'ai'] &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 20000 &&
             (!('citations' in data) || (data.citations is list && data.citations.size() <= 20));
    }

    function isValidAuditLog(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 150)) &&
             (!('documentId' in data) || (data.documentId is string && data.documentId.size() <= 128)) &&
             (!('documentTitle' in data) || (data.documentTitle is string && data.documentTitle.size() <= 200)) &&
             data.action is string && data.action.size() > 0 && data.action.size() <= 100 &&
             data.details is string && data.details.size() <= 2000;
    }

    // Documents collection
    match /documents/{documentId} {
      allow get: if isSignedIn() && isValidId(documentId) && isDocMember(existing());
      allow list: if isSignedIn() && isDocMember(existing());

      allow create: if isSignedIn() && isValidId(documentId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().keys().hasAll(['ownerId', 'title', 'format', 'content', 'createdAt', 'updatedAt']) &&
                       isValidDocument(incoming());

      allow update: if isSignedIn() && isValidId(documentId) &&
                       isDocMember(existing()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidDocument(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'content', 'summary', 'summaryStatus', 'cloudSource',
                         'pageCount', 'wordCount', 'collaborators', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(documentId) && existing().ownerId == request.auth.uid;

      // Subcollection: Insights
      match /insights/{insightId} {
        allow get: if isSignedIn() && isValidId(insightId) && isDocMember(existing());
        allow list: if isSignedIn() && isDocMember(existing());

        allow create: if isSignedIn() && isValidId(insightId) &&
                         isDocMember(incoming()) &&
                         incoming().documentId == documentId &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidInsight(incoming());

        allow update: if isSignedIn() && isValidId(insightId) &&
                         isDocMember(existing()) &&
                         incoming().ownerId == existing().ownerId &&
                         incoming().documentId == existing().documentId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidInsight(incoming());

        allow delete: if isSignedIn() && isValidId(insightId) && isDocMember(existing());
      }

      // Subcollection: Comments
      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(commentId) && isDocMember(existing());
        allow list: if isSignedIn() && isDocMember(existing());

        allow create: if isSignedIn() && isValidId(commentId) &&
                         isDocMember(incoming()) &&
                         incoming().documentId == documentId &&
                         incoming().authorId == request.auth.uid &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidComment(incoming());

        allow update: if isSignedIn() && isValidId(commentId) &&
                         isDocMember(existing()) &&
                         incoming().authorId == existing().authorId &&
                         incoming().documentId == existing().documentId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidComment(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['text', 'resolved', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(commentId) &&
                         (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
      }

      // Subcollection: Chat Messages
      match /chatMessages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId) && isDocMember(existing());
        allow list: if isSignedIn() && isDocMember(existing());

        allow create: if isSignedIn() && isValidId(messageId) &&
                         isDocMember(incoming()) &&
                         incoming().documentId == documentId &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidChatMessage(incoming());

        allow update: if false; // Chat messages are append-only

        allow delete: if isSignedIn() && isValidId(messageId) && isDocMember(existing());
      }
    }

    // Audit Logs collection
    match /auditLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(logId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().timestamp is timestamp && incoming().timestamp <= request.time &&
                       isValidAuditLog(incoming());

      allow update: if false; // Audit logs are immutable
      allow delete: if isSignedIn() && isValidId(logId) && existing().userId == request.auth.uid;
    }
  }
}
